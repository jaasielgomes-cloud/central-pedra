class LeadEvent(BaseModel):
    lead_email: str = Field(..., description="Email do lead")
    lead_name: Optional[str] = Field(default=None, description="Nome do lead")
    company_name: Optional[str] = Field(default=None, description="Empresa do lead")
    message: str = Field(..., description="Mensagem recebida do lead")
    source: str = Field(default="manual_simulate", description="Origem do evento")
    campaign_id: Optional[str] = Field(default=None, description="ID da campanha Lemlist, se houver")


class ApprovalDecision(BaseModel):
