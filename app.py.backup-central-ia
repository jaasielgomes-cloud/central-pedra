@app.get("/approvals")
def list_approvals(status: Optional[str] = "pending") -> Dict[str, Any]:
    approvals = read_jsonl(APPROVALS_FILE)
    if status:
        approvals = [a for a in approvals if a.get("status") == status]
    return {"ok": True, "total": len(approvals), "items": approvals}


@app.post("/approvals/decision")
def approval_decision(decision: ApprovalDecision) -> Dict[str, Any]:
    approvals = read_jsonl(APPROVALS_FILE)
    selected = None
    for item in approvals:
        if item.get("approval_id") == decision.approval_id:
            selected = item
            break

    if not selected:
        raise HTTPException(status_code=404, detail="approval_id não encontrado")

    if selected.get("status") != "pending":
        return {"ok": False, "message": "Este item já foi decidido.", "approval": selected}

    normalized = decision.decision.strip().lower()
    if normalized not in ["approve", "reject"]:
        raise HTTPException(status_code=400, detail="decision deve ser approve ou reject")

    reply = decision.edited_reply or selected["analysis"].get("reply_ptbr", "")

    lemlist_result = None
    if normalized == "approve":
        lemlist_result = send_lemlist_reply(selected, reply)

    selected["status"] = "approved" if normalized == "approve" else "rejected"
    selected["decided_at"] = now_iso()
    selected["reviewer"] = decision.reviewer
    selected["final_reply"] = reply
    selected["lemlist_result"] = lemlist_result

    # Regrava fila inteira de forma simples para MVP.
    with open(APPROVALS_FILE, "w", encoding="utf-8") as f:
        for item in approvals:
            if item.get("approval_id") == decision.approval_id:
                item = selected
            f.write(json.dumps(item, ensure_ascii=False) + "\n")

    append_jsonl(LOG_FILE, {"created_at": now_iso(), "type": "approval_decision", "approval": selected})
    return {"ok": True, "message": "Decisão registrada.", "approval": selected}


def lemlist_auth_headers():
    api_key = os.getenv("LEMLIST_API_KEY")

    if not api_key:
        return None

    token = base64.b64encode(f":{api_key}".encode("utf-8")).decode("utf-8")

    return {
        "Authorization": f"Basic {token}",
        "Content-Type": "application/json",
    }


@app.get("/lemlist/campaigns")
def list_lemlist_campaigns():
    headers = lemlist_auth_headers()

    if not headers:
        return {
            "ok": False,
            "error": "missing_lemlist_api_key",
            "campaigns": [],
        }

    base_url = os.getenv("LEMLIST_BASE_URL", "https://api.lemlist.com/api").rstrip("/")

    try:
        response = requests.get(
            f"{base_url}/campaigns",
            headers=headers,
            timeout=30,
        )

        if response.status_code >= 400:
            return {
                "ok": False,
                "status_code": response.status_code,
                "error": response.text,
                "campaigns": [],
            }

        data = response.json()

        return {
            "ok": True,
            "total": len(data) if isinstance(data, list) else 1,
            "campaigns": data,
        }

    except Exception as error:
        return {
            "ok": False,
            "error": str(error),
            "campaigns": [],
        }




