def campaign_builder_collect_data(source: str):
    result = {
        "source": source,
        "lemlist": {
            "available": False,
            "total_campaigns": 0,
            "running_campaigns": 0,
            "paused_campaigns": 0,
            "draft_campaigns": 0,
            "top_campaigns": [],
        },
        "pipedrive": {
            "available": False,
            "open_deals": 0,
            "pending_activities": 0,
            "deals_without_next_activity": 0,
            "deals_without_value": 0,
            "suggested_improvements": [],
        },
        "commercial_focus": "resposta → oportunidade → reunião → proposta → venda"
    }

    wants_lemlist = source in ["lemlist", "lemlist_pipedrive", "all"]
    wants_pipedrive = source in ["pipedrive", "lemlist_pipedrive", "all"]

    if wants_lemlist:
        try:
            lemlist_data = list_lemlist_campaigns()
            campaigns = lemlist_data.get("campaigns", []) if isinstance(lemlist_data, dict) else []

            result["lemlist"]["available"] = True
            result["lemlist"]["total_campaigns"] = len(campaigns)
            result["lemlist"]["running_campaigns"] = len([c for c in campaigns if c.get("status") == "running"])
            result["lemlist"]["paused_campaigns"] = len([c for c in campaigns if c.get("status") == "paused"])
            result["lemlist"]["draft_campaigns"] = len([c for c in campaigns if c.get("status") == "draft"])

            result["lemlist"]["top_campaigns"] = [
                {
                    "name": c.get("name"),
                    "status": c.get("status"),
                    "created_at": c.get("createdAt"),
                }
                for c in campaigns[:15]
            ]

            try:
                comparison = commercial_comparison()
                ranked = comparison.get("lemlist", {}).get("campaigns_ranked", [])
                if ranked:
                    result["lemlist"]["top_campaigns"] = [
                        {
                            "name": c.get("name"),
                            "status": c.get("status"),
                            "priority": c.get("priority"),
                            "recommendation": c.get("recommendation"),
                        }
                        for c in ranked[:15]
                    ]
            except Exception:
                pass

        except Exception as error:
            result["lemlist"]["error"] = str(error)

    if wants_pipedrive:
        try:
            if "pipedrive_intelligence_overview" in globals():
                pipe_data = pipedrive_intelligence_overview()
                analysis = pipe_data.get("analysis", {})
                summary = analysis.get("summary", {})
                suggested = analysis.get("suggested_actions", [])

                result["pipedrive"]["available"] = True
                result["pipedrive"]["open_deals"] = summary.get("open_deals", 0)
                result["pipedrive"]["pending_activities"] = summary.get("pending_activities", 0)
                result["pipedrive"]["deals_without_next_activity"] = summary.get("deals_without_next_activity", 0)
                result["pipedrive"]["deals_without_value"] = summary.get("deals_without_value", 0)

                result["pipedrive"]["suggested_improvements"] = [
                    {
                        "deal_title": a.get("deal_title"),
                        "problem": a.get("problem"),
                        "recommendation": a.get("recommendation"),
                        "agent": a.get("agent"),
                    }
                    for a in suggested[:15]
                ]

            else:
                comparison = commercial_comparison()
                metrics = comparison.get("pipedrive", {}).get("metrics", {})

                result["pipedrive"]["available"] = True
                result["pipedrive"]["open_deals"] = metrics.get("open_deals", 0)
                result["pipedrive"]["pending_activities"] = metrics.get("pending_activities", 0)
                result["pipedrive"]["deals_without_next_activity"] = metrics.get("deals_without_next_activity", 0)
                result["pipedrive"]["deals_without_value"] = 0

        except Exception as error:
            result["pipedrive"]["error"] = str(error)

    return result


