def _resolve_provider(requested: str) -> str:
    """Resolve 'auto' para o melhor provedor disponível. Retorna 'gemini', 'claude', 'openai' ou 'none'."""
    if requested in ("gemini", "claude", "openai"):
        return requested
    # auto: prioridade Gemini > Claude > OpenAI
    if GEMINI_API_KEY:
        return "gemini"
    if ANTHROPIC_API_KEY:
        return "claude"
    if OPENAI_API_KEY:
        return "openai"
    return "none"


def _convert_messages_to_claude(messages: list) -> tuple:
    """Converte mensagens OpenAI-format para Claude. Retorna (system_str, claude_messages)."""
    system = ""
    claude_messages: list = []

    for msg in messages:
        role = msg["role"]
        if role == "system":
            system = msg.get("content", "")
        elif role == "user":
            claude_messages.append({"role": "user", "content": msg["content"]})
        elif role == "assistant":
            content: list = []
            if msg.get("content"):
                content.append({"type": "text", "text": msg["content"]})
            for tc in msg.get("tool_calls", []):
                content.append({
                    "type": "tool_use",
                    "id": tc["id"],
                    "name": tc["function"]["name"],
                    "input": json.loads(tc["function"]["arguments"]),
                })
            claude_messages.append({"role": "assistant", "content": content or [{"type": "text", "text": ""}]})
        elif role == "tool":
            tool_result = {
                "type": "tool_result",
                "tool_use_id": msg["tool_call_id"],
                "content": msg["content"],
            }
            # agrupa múltiplos tool_results num único user message
            if claude_messages and claude_messages[-1]["role"] == "user" and isinstance(claude_messages[-1]["content"], list):
                claude_messages[-1]["content"].append(tool_result)
            else:
                claude_messages.append({"role": "user", "content": [tool_result]})

    return system, claude_messages


def _convert_tools_to_claude(openai_tools: list) -> list:
    return [
        {
            "name": t["function"]["name"],
            "description": t["function"]["description"],
            "input_schema": t["function"]["parameters"],
        }
        for t in openai_tools
    ]


def _call_claude(messages: list, tools: list = None, temperature: float = 0.3) -> dict:
    """Chama Anthropic API e retorna resposta no formato OpenAI (normalizado)."""
    system, claude_messages = _convert_messages_to_claude(messages)
    payload: dict = {
        "model": CLAUDE_MODEL,
        "max_tokens": 2048,
        "messages": claude_messages,
        "temperature": temperature,
    }
    if system:
        payload["system"] = system
    if tools:
        payload["tools"] = _convert_tools_to_claude(tools)

    resp = requests.post(
        "https://api.anthropic.com/v1/messages",
        headers={
            "x-api-key": ANTHROPIC_API_KEY,
            "anthropic-version": "2023-06-01",
            "Content-Type": "application/json",
        },
        json=payload,
        timeout=90,
    )

    if resp.status_code == 429:
        raise RuntimeError("Limite de requisições Claude atingido. Aguarde e tente novamente.")
    if not resp.ok:
        raise RuntimeError(f"Erro Claude {resp.status_code}: {resp.text[:300]}")

    data = resp.json()
    content_blocks = data.get("content", [])
    stop_reason = data.get("stop_reason", "end_turn")

    text_parts = [b["text"] for b in content_blocks if b.get("type") == "text"]
    tool_blocks = [b for b in content_blocks if b.get("type") == "tool_use"]

    if stop_reason == "tool_use" and tool_blocks:
        tool_calls = [
            {
                "id": b["id"],
                "type": "function",
                "function": {"name": b["name"], "arguments": json.dumps(b["input"], ensure_ascii=False)},
            }
            for b in tool_blocks
        ]
        return {
            "choices": [{
                "finish_reason": "tool_calls",
                "message": {"role": "assistant", "content": " ".join(text_parts) or None, "tool_calls": tool_calls},
            }]
        }

    return {
        "choices": [{
            "finish_reason": "stop",
            "message": {"role": "assistant", "content": " ".join(text_parts)},
        }]
    }


def _ai_chat_completions(messages: list, tools: list = None, temperature: float = 0.3, provider: str = "auto") -> dict:
    """Chama o provedor de IA selecionado e retorna resposta no formato OpenAI."""
    resolved = _resolve_provider(provider)

    if resolved == "none":
        raise ValueError("Nenhuma chave de IA configurada. Adicione GEMINI_API_KEY, ANTHROPIC_API_KEY ou OPENAI_API_KEY no .env")

    if resolved == "claude":
        return _call_claude(messages, tools, temperature)

    # Gemini e OpenAI usam endpoint compatível com Chat Completions
    if resolved == "gemini":
        url = f"{GEMINI_BASE_URL}/chat/completions"
        api_key = GEMINI_API_KEY
        model = GEMINI_MODEL
        provider_name = "Gemini"
    else:
        url = "https://api.openai.com/v1/chat/completions"
        api_key = OPENAI_API_KEY
        model = OPENAI_MODEL
        provider_name = "OpenAI"

    payload: dict = {"model": model, "messages": messages, "temperature": temperature}
    if tools:
        payload["tools"] = tools
        payload["tool_choice"] = "auto"

    resp = requests.post(
        url,
        headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
        json=payload,
        timeout=90,
    )

    if resp.status_code == 429:
        retry_after = resp.headers.get("Retry-After", "alguns segundos")
        raise RuntimeError(f"Limite de requisições {provider_name} atingido. Aguarde {retry_after} e tente novamente.")
    if not resp.ok:
        raise RuntimeError(f"Erro {provider_name} {resp.status_code}: {resp.text[:300]}")

    return resp.json()


