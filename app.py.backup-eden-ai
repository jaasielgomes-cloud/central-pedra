def pipedrive_post(path: str, payload: Dict[str, Any]):
    api_key = os.getenv("PIPEDRIVE_API_KEY") or os.getenv("PIPEDRIVE_API_TOKEN")

    if not api_key:
        return {
            "ok": False,
            "error": "missing_pipedrive_api_key",
        }

    base_url = os.getenv("PIPEDRIVE_BASE_URL", "https://api.pipedrive.com").rstrip("/")

    try:
        response = requests.post(
            f"{base_url}/v1{path}",
            params={"api_token": api_key},
            json=payload,
            timeout=30,
        )

        if response.status_code >= 400:
            return {
                "ok": False,
                "status_code": response.status_code,
                "error": response.text,
            }

        return response.json()

    except Exception as error:
        return {
            "ok": False,
            "error": str(error),
        }


