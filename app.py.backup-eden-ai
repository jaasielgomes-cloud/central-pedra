        except Exception as exc:
            return {"ok": False, "error": "request_failed", "message": str(exc)}

        choice = data["choices"][0]
        ai_message = choice["message"]
        messages.append(ai_message)

        if choice["finish_reason"] == "tool_calls":
            for tc in ai_message.get("tool_calls", []):
                fn_name = tc["function"]["name"]
                fn_args = json.loads(tc["function"]["arguments"])
                result_str = _execute_tool(fn_name, fn_args)
                result_data = json.loads(result_str)
                actions_taken.append({"tool": fn_name, "args": fn_args, "result": result_data})
                messages.append({"role": "tool", "tool_call_id": tc["id"], "content": result_str})
        else:
            final_text = ai_message.get("content", "")
            history = read_json_file(COMMAND_HISTORY_FILE)
            history.append({
                "id": str(uuid.uuid4()),
                "message": payload.message,
                "context": payload.context,
                "created_by": payload.created_by,
                "created_at": now_iso(),
                "response": final_text,
                "actions_taken": actions_taken,
            })
            write_json_file(COMMAND_HISTORY_FILE, history[-300:])
            return {
                "ok": True,
                "response": final_text,
                "actions_taken": actions_taken,
                "actions_count": len(actions_taken),
                "provider_used": provider,
            }

    return {"ok": False, "error": "max_iterations_reached"}
