def _tool_create_pipedrive_deal(
    deal_title: str,
    person_name: str = "",
    person_email: str = "",
    company_name: str = "",
    deal_value: Optional[float] = None,
    note: str = "",
) -> dict:
    person_id = None
    if person_name or person_email:
        person_payload: dict = {
            "name": person_name or person_email,
            "email": [{"value": person_email, "primary": True}] if person_email else [],
            "org_name": company_name or "",
        }
        person_result = pipedrive_request("POST", "/v1/persons", person_payload)
        try:
            person_id = person_result["response"]["data"]["id"]
        except Exception:
            pass

    deal_payload: dict = {"title": deal_title, "status": "open"}
    if person_id:
        deal_payload["person_id"] = person_id
    if deal_value is not None:
        deal_payload["value"] = deal_value

    deal_result = pipedrive_request("POST", "/v1/deals", deal_payload)
    deal_id = None
    try:
        deal_id = deal_result["response"]["data"]["id"]
    except Exception:
        pass

    if note and deal_id:
        note_payload: dict = {"content": note, "deal_id": deal_id}
        if person_id:
            note_payload["person_id"] = person_id
        pipedrive_request("POST", "/v1/notes", note_payload)

    return {
        "ok": True,
        "person_id": person_id,
        "deal_id": deal_id,
        "deal_result": deal_result.get("response", {}).get("data", {}),
