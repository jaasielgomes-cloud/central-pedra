@app.post("/pipedrive-intelligence/actions/decision")
def decide_pipedrive_action(payload: PipedriveActionDecision):
    actions = read_pipedrive_actions()

    for action in actions:
        if action.get("action_id") == payload.action_id:
            if payload.decision == "reject":
                action["status"] = "rejected"
                action["reviewed_by"] = payload.reviewer
                action["reviewed_at"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
                write_pipedrive_actions(actions)

                return {
                    "ok": True,
                    "message": "Ação rejeitada. Nada foi alterado no Pipedrive.",
                    "action": action,
                }

            if payload.decision != "approve":
                raise HTTPException(status_code=400, detail="decision deve ser approve ou reject")

            action_type = action.get("type")
            action_payload = action.get("payload") or {}

            if action_type == "create_activity":
                result = pipedrive_post("/activities", action_payload)

            elif action_type == "add_note":
                result = pipedrive_post("/notes", action_payload)

            elif action_type == "update_deal":
                deal_id = action.get("deal_id")
                result = pipedrive_put(f"/deals/{deal_id}", action_payload)

            else:
                result = {
                    "ok": False,
                    "error": f"Tipo de ação não suportado: {action_type}"
                }

            action["status"] = "approved_executed"
            action["reviewed_by"] = payload.reviewer
            action["reviewed_at"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
            action["execution_result"] = result

            write_pipedrive_actions(actions)

            return {
                "ok": True,
                "message": "Ação aprovada e executada no Pipedrive.",
                "action": action,
            }

    raise HTTPException(status_code=404, detail="Ação não encontrada")


