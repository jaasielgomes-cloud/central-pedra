    lost_deals = [d for d in deals if d.get("status") == "lost"]

    total_closed = len(won_deals) + len(lost_deals)
    win_rate = (len(won_deals) / total_closed * 100) if total_closed > 0 else None

    total_value_open = sum(float(d.get("value") or 0) for d in open_deals)
    total_value_won = sum(float(d.get("value") or 0) for d in won_deals)
    average_deal_value = (sum(float(d.get("value") or 0) for d in deals) / len(deals)) if deals else None

    pending_activities = [a for a in activities if not a.get("done")]
    done_activities = [a for a in activities if a.get("done")]

    deals_without_next_activity = [
        d for d in open_deals
        if not d.get("next_activity_date") and not d.get("next_activity_id")
    ]

    deals_without_next_activity_rate = (
        len(deals_without_next_activity) / len(open_deals) * 100
        if open_deals else None
    )

    lemlist_campaigns_ranked = []

    for campaign in campaigns:
        score = commercial_status_score(campaign)

        lemlist_campaigns_ranked.append({
            "campaign_id": campaign.get("_id"),
            "name": campaign.get("name"),
            "status": campaign.get("status"),
            "archived": campaign.get("archived", False),
