def compare_with_market(current, benchmark, higher_is_better=True):
    if current is None:
        return {
            "current": None,
            "benchmark": benchmark,
            "difference": None,
            "status": "pendente de integração",
            "recommendation": "Conectar os dados reais para análise completa."
        }

    try:
        current_value = float(current)
        benchmark_value = float(benchmark)
    except Exception:
        return {
            "current": current,
            "benchmark": benchmark,
            "difference": None,
            "status": "não comparável",
            "recommendation": "Revisar o formato dos dados."
        }

    difference = current_value - benchmark_value

    if higher_is_better:
        if current_value >= benchmark_value * 1.25:
            status = "excelente"
            recommendation = "Manter estratégia e criar variações para teste A/B."
        elif current_value >= benchmark_value:
            status = "acima da média"
            recommendation = "Manter campanha ativa e otimizar mensagens vencedoras."
        elif current_value >= benchmark_value * 0.75:
            status = "próximo da média"
            recommendation = "Revisar abordagem, público e cadência."
        else:
            status = "abaixo do mercado"
            recommendation = "Reestruturar mensagem, segmentação e proposta de valor."
    else:
        if current_value <= benchmark_value:
            status = "dentro do ideal"
            recommendation = "Manter controle e monitorar evolução."
        elif current_value <= benchmark_value * 1.5:
            status = "atenção"
            recommendation = "Criar plano de correção e acompanhamento."
        else:
            status = "crítico"
            recommendation = "Ação imediata recomendada pelos agentes comerciais."

    return {
        "current": current_value,
        "benchmark": benchmark_value,
        "difference": difference,
        "status": status,
        "recommendation": recommendation
    }


def safe_pipedrive_get(path: str, params: Optional[Dict[str, Any]] = None):
    if "pipedrive_get" in globals():
        try:
            return pipedrive_get(path, params)
        except Exception as error:
            return {"success": False, "error": str(error), "data": []}

    api_key = os.getenv("PIPEDRIVE_API_KEY") or os.getenv("PIPEDRIVE_API_TOKEN")

    if not api_key:
        return {"success": False, "error": "missing_pipedrive_api_key", "data": []}

    base_url = os.getenv("PIPEDRIVE_BASE_URL", "https://api.pipedrive.com").rstrip("/")
    query = params.copy() if params else {}
    query["api_token"] = api_key

    try:
        response = requests.get(f"{base_url}/v1{path}", params=query, timeout=30)

        if response.status_code >= 400:
            return {
                "success": False,
                "status_code": response.status_code,
                "error": response.text,
                "data": []
            }

        return response.json()

    except Exception as error:
        return {"success": False, "error": str(error), "data": []}


def commercial_status_score(campaign):
    score = 0
    name = (campaign.get("name") or "").lower()

    if campaign.get("status") == "running":
        score += 70
    elif campaign.get("status") == "paused":
        score += 35
    elif campaign.get("status") == "draft":
        score += 15

    if campaign.get("archived"):
        score -= 25

    if "pós" in name or "pos" in name or "gerente" in name:
        score += 12

    if "diretor" in name or "ceo" in name:
        score += 10

    if "compras" in name or "suprimentos" in name:
        score += 6

    return max(0, min(score, 100))


def commercial_priority(score):
    if score >= 80:
        return "alta prioridade"
    if score >= 55:
        return "média prioridade"
    if score >= 30:
        return "baixa prioridade"
    return "não priorizar"


def campaign_recommendation(campaign):
    if campaign.get("archived"):
        return "Usar apenas como histórico."

    status = campaign.get("status")

    if status == "running":
        return "Manter em análise ativa e cruzar com oportunidades do Pipedrive."

    if status == "paused":
        return "Revisar abordagem antes de reativar."

    if status == "draft":
        return "Finalizar estratégia antes de iniciar disparos."

    return "Rodar análise dos agentes antes de decidir."


