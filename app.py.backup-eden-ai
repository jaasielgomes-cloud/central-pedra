        })

    lemlist_campaigns_ranked = sorted(
        lemlist_campaigns_ranked,
        key=lambda item: item.get("commercial_score", 0),
        reverse=True
    )

    lemlist_metrics = {
        "total_campaigns": len(campaigns),
        "running_campaigns": len(running_campaigns),
        "paused_campaigns": len(paused_campaigns),
