def simple_ai_campaign_generation(payload: CampaignAIDraftRequest):
    prompt = f"""
Você é um agente comercial do Grupo Pedra.

Crie uma campanha para Lemlist com:
Objetivo: {payload.objective}
Público-alvo: {payload.target_audience}
Oferta: {payload.offer}
Dores: {payload.pain_points}
Tom: {payload.tone}

Entregue em JSON com:
campaign_name,
strategy_summary,
lead_filters,
messages com 5 passos,
recommended_agent,
risk_notes,
approval_notes.

Não envie nada. Apenas gere o rascunho para aprovação humana.
"""

    if not OPENAI_API_KEY:
        return {
            "campaign_name": f"Campanha IA - {payload.target_audience}",
            "strategy_summary": "Rascunho criado sem chamada OpenAI porque a chave não está configurada.",
            "lead_filters": payload.target_audience,
            "messages": [
                {
                    "step": 1,
                    "channel": "LinkedIn",
                    "message": "Mensagem inicial consultiva gerada como fallback."
                },
                {
                    "step": 2,
                    "channel": "Email",
                    "message": "Mensagem de aprofundamento gerada como fallback."
                }
            ],
            "recommended_agent": payload.agent_id,
            "risk_notes": "Validar manualmente antes de enviar.",
            "approval_notes": "Aguardando aprovação de Jaasiel."
        }

    try:
        response = requests.post(
            "https://api.openai.com/v1/responses",
            headers={
                "Authorization": f"Bearer {OPENAI_API_KEY}",
                "Content-Type": "application/json",
            },
            json={
                "model": OPENAI_MODEL,
                "input": prompt,
            },
            timeout=60,
        )

        if response.status_code >= 400:
            return {
                "campaign_name": f"Campanha IA - {payload.target_audience}",
                "strategy_summary": "Falha ao chamar OpenAI. Rascunho fallback criado.",
                "error": response.text,
                "messages": [],
                "approval_notes": "Aguardando aprovação."
            }

        data = response.json()
        output_text = ""

        try:
            output_text = data["output"][0]["content"][0]["text"]
        except Exception:
            output_text = json.dumps(data, ensure_ascii=False)

        return {
            "raw_ai_output": output_text,
            "approval_notes": "Rascunho gerado pela IA. Revisar antes de aprovar."
        }

    except Exception as error:
        return {
            "campaign_name": f"Campanha IA - {payload.target_audience}",
            "strategy_summary": "Erro local ao gerar campanha com IA.",
            "error": str(error),
            "messages": [],
            "approval_notes": "Aguardando aprovação."
        }


