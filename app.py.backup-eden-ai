    running_campaigns = [c for c in campaigns if c.get("status") == "running" and not c.get("archived")]
    paused_campaigns = [c for c in campaigns if c.get("status") == "paused"]
    draft_campaigns = [c for c in campaigns if c.get("status") == "draft"]
    archived_campaigns = [c for c in campaigns if c.get("archived")]

    deals_response = safe_pipedrive_get("/deals", {"limit": 100})
