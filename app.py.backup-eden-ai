        "total_value_open": total_value_open,
        "total_value_won": total_value_won,
        "average_deal_value": average_deal_value,
        "total_activities": len(activities),
        "pending_activities": len(pending_activities),
        "done_activities": len(done_activities),
        "deals_without_next_activity": len(deals_without_next_activity),
        "deals_without_next_activity_rate": deals_without_next_activity_rate
    }

    lemlist_market_comparison = {
        "open_rate": compare_with_market(
            lemlist_metrics["open_rate"],
            benchmarks.get("lemlist_open_rate"),
            True
        ),
        "reply_rate": compare_with_market(
