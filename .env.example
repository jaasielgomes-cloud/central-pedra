# Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA suba o arquivo .env para o GitHub

OPENAI_API_KEY=sua-chave-aqui
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=sua-chave-aqui
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=sua-chave-aqui
CLAUDE_MODEL=claude-haiku-4-5-20251001

GROQ_API_KEY=sua-chave-aqui
GROQ_MODEL=llama-3.3-70b-versatile
ALLOWED_ORIGINS=http://localhost:5173,https://seu-frontend.vercel.app
OUTPUT_DOCUMENTS_DIR=/tmp/central-pedra/documentos
FFMPEG_BIN=ffmpeg

PIPEDRIVE_API_KEY=sua-chave-aqui
